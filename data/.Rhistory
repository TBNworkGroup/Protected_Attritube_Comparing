#TT規則校正 ====
correct_attribute <- function(
data,
value_col,
score_vector,
output_col
) {
species_df <- data %>%
filter(taxonRank == "species") %>%
select(
species_taxonUUID = taxonUUID,
species_value = all_of(value_col)
)
infra_df <- data %>%
filter(taxonRank == "infraspecies") %>%
select(
taxonUUID,
parentUUID,
infra_value = all_of(value_col)
)
infra_summary <- infra_df %>%
filter(
!is.na(infra_value),
infra_value != ""
) %>%
mutate(
risk_score = score_vector[infra_value]
) %>%
arrange(desc(risk_score)) %>%
group_by(parentUUID) %>%
summarise(
highest_infra_value = first(infra_value),
.groups = "drop"
)
species_corrected <- species_df %>%
left_join(
infra_summary,
by = c("species_taxonUUID" = "parentUUID")
) %>%
mutate(
corrected_value = case_when(
!is.na(highest_infra_value)
~ highest_infra_value,
TRUE
~ species_value
)
) %>%
select(
taxonUUID = species_taxonUUID,
corrected_value
)
infra_corrected <- infra_df %>%
left_join(
species_df,
by = c("parentUUID" = "species_taxonUUID")
) %>%
mutate(
corrected_value = case_when(
!is.na(infra_value) &
infra_value != ""
~ infra_value,
TRUE
~ species_value
)
) %>%
select(
taxonUUID,
corrected_value
)
corrected_table <- bind_rows(
species_corrected,
infra_corrected
) %>%
rename(
!!output_col := corrected_value
)
return(corrected_table)
}
